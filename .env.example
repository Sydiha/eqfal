# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database (optional — server starts without it and reports DB as disconnected)
DATABASE_URL=postgresql://user:password@localhost:5432/eqfal

# Security
SESSION_SECRET=change-this-to-a-long-random-string

# Document storage (optional; defaults to .data/documents)
DOCUMENT_STORAGE_DIR=/absolute/path/to/eqfal-documents

# File storage backend: "local" (default, development/tests) or "object" (Replit App Storage).
# DO NOT enable "object" in production until Task 6C-2B (backup/restore for Object Storage) is completed. See docs/OBJECT_STORAGE.md.
# STORAGE_BACKEND=local
# OBJECT_STORAGE_BUCKET_ID=   # required with "object"; use a different bucket for development and production
# OBJECT_STORAGE_BACKUP_SUPPORT_CONFIRMED=   # owner-only switch, set to "true" after Task 6C-2B is merged

# Client
VITE_API_URL=http://localhost:3001

# Reverse proxy hops to trust for client IP (login rate limiting). Unset/false = trust none (X-Forwarded-For ignored).
# Behind exactly one proxy that sets X-Forwarded-For: TRUST_PROXY=1
# TRUST_PROXY=
# Production: NODE_ENV=production, APP_PUBLIC_ORIGINS=https://<public origin> are required; set TRUST_PROXY to the proxy hop count or subnet (mandatory when a hosting-platform proxy is detected, otherwise a startup warning if unset).
# API clients that keep the session cookie must send an allowlisted Origin header on writes.
# Production serves client/dist from Express (build first: npm run build). Optional override of its location:
# FRONTEND_DIST_DIR=/absolute/path/to/client/dist
